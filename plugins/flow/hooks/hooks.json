{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3",
                        "args": ["-I", "${CLAUDE_PLUGIN_ROOT}/scripts/readonly_agent_bash.py"],
                        "timeout": 10,
                        "onFailure": "block"
                    }
                ]
            }
        ]
    }
}
